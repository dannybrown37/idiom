---
import { CATALOG } from "../elements";
import { PALETTES } from "../themes";

const entries = [
  { id: "foundations", title: "Foundations", group: "Tokens", terms: "" },
  ...CATALOG.flatMap((category) => [
    { id: category.id, title: category.title, group: "Section", terms: "" },
    ...category.elements.map((element) => ({
      id: element.id.replace("/", "-"),
      title: element.title,
      group: category.title,
      terms: element.id,
    })),
  ]),
];
---

<dialog
  class="dialog site-search"
  id="site-search"
  aria-label="Search elements and themes"
  closedby="any"
>
  <label class="search">
    <svg class="search-icon" viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="7" cy="7" r="4.5"></circle>
      <path d="M10.5 10.5L14 14"></path>
    </svg>
    <input
      id="site-search-input"
      type="text"
      enterkeyhint="search"
      placeholder="Elements, sections, themes"
      autocomplete="off"
      role="combobox"
      aria-label="Search elements and themes"
      aria-expanded="true"
      aria-controls="site-search-results"
      aria-autocomplete="list"
    />
  </label>
  <ul class="site-search-results" id="site-search-results" role="listbox">
    {
      entries.map((entry) => (
        <li
          id={`sr-${entry.id}`}
          role="option"
          aria-selected="false"
          data-target={entry.id}
          data-title={entry.title}
          data-group={entry.group}
          data-terms={entry.terms}
        >
          <span>{entry.title}</span>
          <span class="site-search-group">{entry.group}</span>
        </li>
      ))
    }
    {
      PALETTES.map((palette) => (
        <li
          id={`sr-theme-${palette.id}`}
          role="option"
          aria-selected="false"
          data-palette-id={palette.id}
          data-title={palette.name}
          data-group="Theme"
          data-terms={palette.usedBy.map((site) => site.name).join(" ")}
        >
          <span>{palette.name}</span>
          <span class="site-search-group">Theme</span>
        </li>
      ))
    }
  </ul>
  <p class="site-search-empty" hidden>No matches.</p>
</dialog>

<script>
  import { search } from "../lib/search";

  const dialog = document.getElementById("site-search") as HTMLDialogElement;
  const input = document.getElementById("site-search-input") as HTMLInputElement;
  const list = document.getElementById("site-search-results") as HTMLElement;
  const empty = dialog.querySelector<HTMLElement>(".site-search-empty");
  const items = [...list.querySelectorAll<HTMLLIElement>("[role=option]")];
  const entries = items.map((li) => ({
    id: li.id,
    title: li.dataset.title ?? "",
    group: li.dataset.group ?? "",
    terms: li.dataset.terms ?? "",
    li,
  }));
  let shown: HTMLLIElement[] = [];
  let active = 0;

  const highlight = (index: number) => {
    active = Math.max(0, Math.min(index, shown.length - 1));
    shown.forEach((li, i) => {
      li.setAttribute("aria-selected", String(i === active));
    });
    const current = shown[active];
    if (current) {
      input.setAttribute("aria-activedescendant", current.id);
      current.scrollIntoView({ block: "nearest" });
    } else {
      input.removeAttribute("aria-activedescendant");
    }
  };

  const render = () => {
    shown = search(entries, input.value).map((entry) => entry.li);
    for (const li of items) li.hidden = true;
    for (const li of shown) {
      li.hidden = false;
      list.append(li);
    }
    if (empty) empty.hidden = shown.length > 0;
    highlight(0);
  };

  const choose = (li: HTMLLIElement | undefined) => {
    if (!li) return;
    dialog.close();
    if (li.dataset.paletteId) {
      localStorage.setItem("idiom:palette", li.dataset.paletteId);
      document.dispatchEvent(new Event("idiom:theme"));
      return;
    }
    const target = document.getElementById(li.dataset.target ?? "");
    if (!target) return;
    history.replaceState(null, "", `#${target.id}`);
    target.scrollIntoView();
    target.tabIndex = -1;
    target.focus({ preventScroll: true });
  };

  document.addEventListener("idiom:search", () => {
    if (dialog.open) return;
    input.value = "";
    render();
    dialog.showModal();
    input.focus();
  });

  input.addEventListener("input", render);
  input.addEventListener("keydown", (event) => {
    if (event.key === "ArrowDown") highlight(active + 1);
    else if (event.key === "ArrowUp") highlight(active - 1);
    else if (event.key === "Enter") choose(shown[active]);
    else return;
    event.preventDefault();
  });
  list.addEventListener("click", (event) => {
    choose(
      (event.target as Element).closest<HTMLLIElement>("[role=option]") ??
        undefined,
    );
  });
</script>
